{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "title": "Request Rate Over Time",
  "autosize": { "type": "fit", "contains": "padding" },
  "data": {
    "url": {
      "%type%": "esql",
      "%context%": true,
      "%timefield%": "@timestamp",
      "query": "FROM logs-* | WHERE @timestamp >= ?_tstart AND @timestamp <= ?_tend | STATS requests = COUNT() BY time_bucket = DATE_TRUNC(5 minutes, @timestamp) | SORT time_bucket ASC"
    }
  },
  "mark": { "type": "line", "point": false, "tooltip": true, "strokeWidth": 2, "color": "#6092C0" },
  "encoding": {
    "x": { "field": "time_bucket", "type": "temporal", "title": null, "axis": { "labelAngle": 0, "tickCount": 8 } },
    "y": { "field": "requests", "type": "quantitative", "title": null }
  },
  "config": {
    "axis": { "domainColor": "#444", "tickColor": "#444" },
    "view": { "stroke": null }
  }
}
